<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>vista.css, a Windows Vista Aero design system</title>
    <link rel="stylesheet" href="aurora.css?v=<%= cacheBust %>" />
    <link id="theme-link" rel="stylesheet" href="Vista.css?v=<%= cacheBust %>" />
    <link rel="stylesheet" href="docs.css?v=<%= cacheBust %>" />
  </head>
  <body>
<%
  const nav = [
    ["Window", [
      ["window", "Window"],
      ["window-controls", "Window controls"],
      ["status-bar", "Status bar"],
    ]],
    ["Controls", [
      ["buttons", "Buttons"],
      ["text-fields", "Text fields"],
      ["combobox", "Combobox"],
      ["checkboxes-and-radios", "Checkboxes and radios"],
      ["slider", "Slider"],
    ]],
    ["Containers", [
      ["tabs", "Tabs"],
      ["group-box", "Group box"],
      ["tree-view", "Tree view"],
      ["progress-bar", "Progress bar"],
      ["scrollbar", "Scrollbar"],
    ]],
    ["Shell & overlays", [
      ["menus", "Menus"],
      ["toolbar", "Toolbar"],
      ["balloon-tooltip", "Balloon tooltip"],
      ["taskbar", "Taskbar"],
    ]],
    ["Data & feedback", [
      ["list-view", "List view"],
      ["search-box", "Search box"],
      ["spinner", "Spinner"],
    ]],
    ["About", [
      ["requirements", "Requirements"],
      ["roadmap", "Roadmap"],
    ]],
  ];
%>
    <aside class="docs-nav" aria-label="Components">
      <ul class="tree-view has-container has-collapse-button has-scrollbar">
        <% nav.forEach(function (group) { %>
        <li>
          <details open>
            <summary><%= group[0] %></summary>
            <ul>
              <% group[1].forEach(function (item) { %>
              <li><a href="#<%= item[0] %>"><%= item[1] %></a></li>
              <% }); %>
            </ul>
          </details>
        </li>
        <% }); %>
      </ul>
    </aside>

    <main class="docs-page">
      <header class="docs-header">
        <h1>vista.css</h1>
        <p class="docs-tagline">
          A design system for building faithful recreations of the Windows Vista
          Aero interface. No JavaScript, just semantic HTML and one stylesheet.
        </p>
        <pre
          class="docs-install"
        ><code>&lt;link rel="stylesheet" href="https://unpkg.com/vista.css"&gt;</code></pre>
        <p class="docs-version">v<%= version %></p>
        <button
          id="theme-toggle"
          class="docs-theme-toggle"
          type="button"
        ></button>
      </header>

      <section class="docs-section" id="window">
        <h2>Window</h2>
        <p>
          The frame is translucent Aero glass: it blurs the page behind it, so
          it needs something, anything, to sit on. The title bar carries the
          window controls; the client area (<code>.window-body</code>) stays
          opaque, exactly as Vista rendered it.
        </p>
        <%- example(`
          <div class="window" style="width: 320px">
            <div class="title-bar">
              <div class="title-bar-text">My First Vista Program</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body">
              <p>Hello, Aero!</p>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="window-controls">
        <h2>Window controls</h2>
        <p>
          Control buttons are keyed off their <code>aria-label</code>, so they
          stay accessible and order-independent. Hover glows blue; Close glows
          red. Use <code>Restore</code> for a maximized window.
        </p>
        <%- example(`
          <div class="window" style="width: 320px">
            <div class="title-bar">
              <div class="title-bar-text">All four controls</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Restore"></button>
                <button aria-label="Help"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body">
              <p>Hover each button.</p>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="status-bar">
        <h2>Status bar</h2>
        <p>
          A row of glass fields pinned to the bottom of the window.
        </p>
        <%- example(`
          <div class="window" style="width: 360px">
            <div class="title-bar">
              <div class="title-bar-text">Documents</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body" style="height: 84px">
              <p>3 items selected</p>
            </div>
            <div class="status-bar">
              <p class="status-bar-field">Ready</p>
              <p class="status-bar-field">3 objects</p>
              <p class="status-bar-field">1.2 MB</p>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="buttons">
        <h2>Buttons</h2>
        <p>
          Glossy Aero push buttons. Hover lights them up; <code>.default</code>
          (or keyboard focus) adds the signature aqua glow.
        </p>
        <%- example(`
          <div class="field-row">
            <button>OK</button>
            <button class="default">Apply</button>
            <button disabled>Disabled</button>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="text-fields">
        <h2>Text fields</h2>
        <p>
          Text inputs and textareas get a white field, a hairline border, and a
          blue glow while focused.
        </p>
        <%- example(`
          <div class="field-row">
            <label for="name">Name</label>
            <input id="name" type="text" value="Nick" />
          </div>
          <div class="field-row" style="margin-top: 8px; align-items: flex-start">
            <label for="notes">Notes</label>
            <textarea id="notes" rows="3" style="width: 220px">Hello, Aero!</textarea>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="combobox">
        <h2>Combobox</h2>
        <p>A glossy Aero dropdown with its own button on the right.</p>
        <%- example(`
          <div class="field-row">
            <label for="theme">Color scheme</label>
            <select id="theme">
              <option>Windows Aero</option>
              <option>Windows Vista Basic</option>
              <option>Windows Classic</option>
            </select>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="checkboxes-and-radios">
        <h2>Checkboxes and radios</h2>
        <p>
          The real input is hidden and the adjacent <code>&lt;label&gt;</code>
          draws the control, exactly like 98.css and XP.css, so the same markup
          works unchanged.
        </p>
        <%- example(`
          <div>
            <div class="field-row">
              <input id="cb1" type="checkbox" checked />
              <label for="cb1">Show hidden files</label>
            </div>
            <div class="field-row" style="margin-top: 6px">
              <input id="cb2" type="checkbox" />
              <label for="cb2">Remember this setting</label>
            </div>
            <div class="field-row" style="margin-top: 6px">
              <input id="rb1" type="radio" name="scheme" checked />
              <label for="rb1">Windows Aero</label>
            </div>
            <div class="field-row" style="margin-top: 6px">
              <input id="rb2" type="radio" name="scheme" />
              <label for="rb2">Windows Vista Basic</label>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="slider">
        <h2>Slider</h2>
        <p>A glossy Aero thumb on a recessed track.</p>
        <%- example(`
          <div style="width: 240px">
            <input type="range" min="0" max="100" value="40" />
          </div>
        `) %>
      </section>

      <section class="docs-section" id="tabs">
        <h2>Tabs</h2>
        <p>
          Inactive tabs use the glossy push-button look; the selected tab goes
          flat and merges into the panel. Add <code>justified</code> to the
          tablist to stretch the tabs.
        </p>
        <%- example(`
          <div class="window" style="width: 380px">
            <div class="title-bar">
              <div class="title-bar-text">Options</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body">
              <menu role="tablist">
                <button aria-selected="true">General</button>
                <button>Security</button>
                <button>Details</button>
              </menu>
              <div role="tabpanel">
                <p>Content of the General tab.</p>
              </div>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="group-box">
        <h2>Group box</h2>
        <p>A rounded hairline frame with the legend cutting through it.</p>
        <%- example(`
          <div class="window" style="width: 320px">
            <div class="title-bar">
              <div class="title-bar-text">Settings</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body">
              <fieldset>
                <legend>Startup</legend>
                <div class="group">
                  <div class="field-row">
                    <input id="gb1" type="checkbox" checked />
                    <label for="gb1">Run at startup</label>
                  </div>
                  <div class="field-row">
                    <input id="gb2" type="checkbox" />
                    <label for="gb2">Show a notification</label>
                  </div>
                </div>
              </fieldset>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="tree-view">
        <h2>Tree view</h2>
        <p>
          Collapsible branches use native <code>&lt;details&gt;</code>, so they
          work without JavaScript. <code>has-container</code> adds the white
          list surface; <code>has-connector</code> adds the optional dotted
          guide lines.
        </p>
        <%- example(`
          <ul class="tree-view has-container has-collapse-button" style="width: 220px">
            <li>
              <details open>
                <summary>Desktop</summary>
                <ul>
                  <li>Documents</li>
                  <li>Pictures</li>
                  <li>
                    <details>
                      <summary>Network</summary>
                      <ul>
                        <li>Server (\\\\srv)</li>
                      </ul>
                    </details>
                  </li>
                </ul>
              </details>
            </li>
          </ul>
        `) %>
      </section>

      <section class="docs-section" id="progress-bar">
        <h2>Progress bar</h2>
        <p>
          The Vista green bar. Give the inner element a width for a determinate
          bar, or add <code>marquee</code> for the indeterminate sweep.
        </p>
        <%- example(`
          <div>
            <div role="progressbar" style="width: 260px">
              <div style="width: 60%"></div>
            </div>
            <div role="progressbar" class="marquee" style="width: 260px; margin-top: 12px"></div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="scrollbar">
        <h2>Scrollbar</h2>
        <p>
          Add <code>has-scrollbar</code> to a scrolling container for the Aero
          track, glossy thumb and arrow buttons.
        </p>
        <%- example(`
          <div class="has-scrollbar" style="width: 260px; height: 130px; overflow-y: scroll; background: #fff; color: #0a0a0a; border: 1px solid #7f9db9; border-radius: 2px; padding: 8px">
            <p style="margin: 0 0 10px">Scroll to see the Aero scrollbar.</p>
            <p style="margin: 0 0 10px">Documents</p>
            <p style="margin: 0 0 10px">Pictures</p>
            <p style="margin: 0 0 10px">Music</p>
            <p style="margin: 0 0 10px">Videos</p>
            <p style="margin: 0">Downloads</p>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="menus">
        <h2>Menus</h2>
        <p>
          A menu bar (<code>role="menubar"</code>) and dropdowns
          (<code>role="menu"</code>) with no JavaScript: submenus open on focus,
          or on hover when the root has <code>can-hover</code>. Use
          <code>has-divider</code> for a separator, <code>aria-disabled</code>
          to disable an item, and a <code>&lt;span&gt;</code> for a shortcut.
        </p>
        <%- example(`
          <div class="window" style="width: 420px">
            <div class="title-bar">
              <div class="title-bar-text">Explorer</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body" style="padding: 0">
              <ul role="menubar" class="can-hover">
                <li role="menuitem" tabindex="0" aria-haspopup="true">
                  File
                  <ul role="menu">
                    <li role="menuitem"><a href="#menus">Open <span>Ctrl+O</span></a></li>
                    <li role="menuitem"><a href="#menus">Save <span>Ctrl+S</span></a></li>
                    <li role="menuitem" class="has-divider"><a href="#menus">Save As... <span>Ctrl+Shift+S</span></a></li>
                    <li role="menuitem"><a href="#menus">Exit</a></li>
                  </ul>
                </li>
                <li role="menuitem" tabindex="0" aria-haspopup="true">
                  Edit
                  <ul role="menu">
                    <li role="menuitem"><a href="#menus">Undo</a></li>
                    <li role="menuitem"><a href="#menus">Copy</a></li>
                    <li role="menuitem"><a href="#menus">Paste</a></li>
                  </ul>
                </li>
                <li role="menuitem" tabindex="0">View</li>
                <li role="menuitem" tabindex="0">Help</li>
              </ul>
              <p style="padding: 8px 10px; margin: 0">Hover <strong>File</strong> or <strong>Edit</strong> to open a menu.</p>
            </div>
          </div>
        `) %>
        <%- example(`
          <ul role="menu" class="can-hover" style="width: 200px">
            <li role="menuitem" tabindex="0" aria-haspopup="true">
              View
              <ul role="menu">
                <li role="menuitem" tabindex="0" aria-haspopup="true">
                  Sort by
                  <ul role="menu">
                    <li role="menuitem"><a href="#menus">Name</a></li>
                    <li role="menuitem"><a href="#menus">Size</a></li>
                  </ul>
                </li>
                <li role="menuitem"><a href="#menus">Refresh</a></li>
              </ul>
            </li>
            <li role="menuitem" class="has-divider"><a href="#menus">Refresh</a></li>
            <li role="menuitem" aria-disabled="true"><a href="#menus">Paste</a></li>
            <li role="menuitem">
              <input type="checkbox" id="mn1" checked />
              <label for="mn1">Show hidden files</label>
            </li>
            <li role="menuitem">
              <input type="radio" name="mnv" id="mn2" checked />
              <label for="mn2">Large icons</label>
            </li>
            <li role="menuitem">
              <input type="radio" name="mnv" id="mn3" />
              <label for="mn3">Small icons</label>
            </li>
          </ul>
        `) %>
      </section>

      <section class="docs-section" id="toolbar">
        <h2>Toolbar</h2>
        <p>Buttons stay flat until you hover them.</p>
        <%- example(`
          <div class="window" style="width: 400px">
            <div class="title-bar">
              <div class="title-bar-text">Command bar</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body" style="padding: 0">
              <div class="toolbar">
                <button>Organize</button>
                <button>Share with</button>
                <button>Burn</button>
                <div class="toolbar-divider"></div>
                <button>New folder</button>
              </div>
              <p style="padding: 8px 10px; margin: 0">The toolbar sits under the menu bar.</p>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="balloon-tooltip">
        <h2>Balloon tooltip</h2>
        <p>
          A Vista balloon, complete with tail. Use <code>is-top</code> to point
          the tail down, and <code>is-left</code> / <code>is-right</code> to move
          it sideways.
        </p>
        <%- example(`
          <div role="tooltip" style="margin-top: 12px">A balloon is better known as a tooltip in web development.</div>
          <div role="tooltip" class="is-top" style="margin-top: 12px">This balloon sits above its control.</div>
        `) %>
      </section>

      <section class="docs-section" id="taskbar">
        <h2>Taskbar</h2>
        <p>
          The Aero glass taskbar: Start orb, glass task buttons and a tray
          clock. It blurs whatever is behind it, so it looks best over a
          wallpaper.
        </p>
        <%- example(`
          <div style="width: 100%">
            <div class="taskbar">
              <button class="start-orb" aria-label="Start"></button>
              <div class="taskbar-tasks">
                <button class="taskbar-button" aria-pressed="true">
                  <span class="taskbar-button-icon"></span>
                  <span class="taskbar-button-text">Windows Explorer</span>
                </button>
                <button class="taskbar-button">
                  <span class="taskbar-button-icon"></span>
                  <span class="taskbar-button-text">Notepad</span>
                </button>
              </div>
              <div class="taskbar-tray">
                <div class="tray-clock">
                  <span>8:00 PM</span>
                  <span>9/27/2026</span>
                </div>
              </div>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="list-view">
        <h2>List view</h2>
        <p>
          The Details view, as a styled table: add the <code>list-view</code>
          class. Sticky gradient headers, an <code>highlighted</code> column or
          row, and an <code>indicator</code> sort caret (add <code>up</code> to
          flip it).
        </p>
        <%- example(`
          <div class="window" style="width: 480px">
            <div class="title-bar">
              <div class="title-bar-text">Pictures</div>
              <div class="title-bar-controls">
                <button aria-label="Minimize"></button>
                <button aria-label="Maximize"></button>
                <button aria-label="Close"></button>
              </div>
            </div>
            <div class="window-body" style="padding: 0">
              <table class="list-view">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Date Taken</th>
                    <th class="highlighted indicator">Tags</th>
                    <th>Size</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Toco Toucan</td>
                    <td>6/24/2005 12:22 PM</td>
                    <td>Sample; Wildlife</td>
                    <td>113 KB</td>
                  </tr>
                  <tr class="highlighted">
                    <td>Dock</td>
                    <td>6/22/2005 8:17 PM</td>
                    <td>Sample; Ocean</td>
                    <td>310 KB</td>
                  </tr>
                  <tr>
                    <td>Autumn Leaves</td>
                    <td>11/4/2005 6:12 PM</td>
                    <td>Sample; Landscape</td>
                    <td>270 KB</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="search-box">
        <h2>Search box</h2>
        <p>
          A magnifier appears while the field is empty. Wrap the input and a
          button in a <code>searchbox</code> for the button-triggered variant.
        </p>
        <%- example(`
          <input type="search" placeholder="Search" />
          <div class="searchbox">
            <input type="search" placeholder="Search" />
            <button aria-label="search"></button>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="spinner">
        <h2>Spinner</h2>
        <p>
          A raster-free loading ring: <code>spinner</code> or
          <code>loader</code>, plus <code>animate</code> to spin it.
        </p>
        <%- example(`
          <div style="display: flex; align-items: center; gap: 18px">
            <span class="spinner" aria-label="Loading"></span>
            <span class="loader animate" aria-label="Processing"></span>
          </div>
        `) %>
      </section>

      <section class="docs-section" id="requirements">
        <h2>Requirements</h2>
        <p>
          The glass effect uses <code>backdrop-filter</code>, supported by every
          current browser. The frame is transparent, so place windows over a
          background: a photo, gradient, or the window of another app.
          <code>autoprefixer</code> adds the <code>-webkit-</code> prefix at
          build time.
        </p>
      </section>

      <section class="docs-section" id="roadmap">
        <h2>Roadmap</h2>
        <p>
          A second theme ships as <code>dist/Vista-Basic.css</code>, the opaque,
          composition-off look. Use the toggle at the top of the page to preview
          it.
        </p>
      </section>

      <footer class="docs-footer">
        <p>
          Inspired by <a href="https://jdan.github.io/98.css/">98.css</a>,
          <a href="https://botoxparty.github.io/XP.css/">XP.css</a> and
          <a href="https://khang-nd.github.io/7.css/">7.css</a>, all MIT
          licensed. vista.css is MIT too.
        </p>
      </footer>
    </main>
    <script src="script.js?v=<%= cacheBust %>"></script>
  </body>
</html>
